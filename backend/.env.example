MONGODB_URI=
MONGODB_DB=bug_report_ai
CORS_ORIGINS=http://localhost:5173
REVIEW_MARGIN=0.25
LOAD_MODELS=true
# Login: production mein AUTH_ENABLED=true rakhein. Development mein false kar sakte hain.
AUTH_ENABLED=true
# Kam se kam 32 characters. Banane ke liye: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
# Itni ghalat koshishon ke baad account LOCKOUT_MINUTES ke liye band.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# /docs wagaira: development mein true, production mein false.
ENABLE_DOCS=false
# HTTPS par deploy karte waqt true.
ENABLE_HSTS=false
# Severity ka model: tfidf (version 1) ya transformer (version 2, ml/artifacts/severity_transformer chahiye).
SEVERITY_MODEL=tfidf
# Sirf transformer ke liye, 0 se 1. Khali chhodein to ml/artifacts/severity_transformer/review_margin.json se aata hai.
TRANSFORMER_REVIEW_MARGIN=
# GitHub se jurna (optional): dono bharein to naye issue par severity ka label aur comment lagta hai.
# GITHUB_WEBHOOK_SECRET kam se kam 16 characters (wahi secret GitHub ke webhook mein bhi likhein).
# GITHUB_TOKEN: fine-grained token jis ko sirf us repository ke Issues par "Read and write" ijazat ho.
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
